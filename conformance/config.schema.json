{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/forestmatt/earned-autonomy/main/conformance/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "$ref": "#/$defs/__schema2"
    },
    "actions": {
      "$ref": "#/$defs/__schema3"
    },
    "flags": {
      "$ref": "#/$defs/__schema30"
    },
    "segments": {
      "$ref": "#/$defs/__schema51"
    },
    "experiments": {
      "$ref": "#/$defs/__schema54"
    },
    "layers": {
      "$ref": "#/$defs/__schema59"
    },
    "holdouts": {
      "$ref": "#/$defs/__schema61"
    },
    "plans": {
      "$ref": "#/$defs/__schema62"
    },
    "lapsedPolicy": {
      "$ref": "#/$defs/__schema64"
    },
    "policies": {
      "$ref": "#/$defs/__schema66"
    },
    "killed": {
      "$ref": "#/$defs/__schema72"
    },
    "rules": {
      "$ref": "#/$defs/__schema73"
    },
    "promotion": {
      "$ref": "#/$defs/__schema96"
    }
  },
  "required": [
    "version",
    "actions"
  ],
  "additionalProperties": false,
  "title": "earned-autonomy config",
  "description": "Everything the earned-autonomy engine needs to decide allow, ask or deny. See SPEC.md.",
  "$defs": {
    "__schema0": {
      "description": "Lets an editor find this schema. Ignored by the engine.",
      "$ref": "#/$defs/__schema1"
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "description": "Config version, echoed on every decision."
    },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/$defs/__schema4"
          },
          "risk": {
            "$ref": "#/$defs/__schema5"
          },
          "reversible": {
            "$ref": "#/$defs/__schema6"
          },
          "ceiling": {
            "$ref": "#/$defs/__schema8"
          },
          "levels": {
            "$ref": "#/$defs/__schema10"
          },
          "feature": {
            "$ref": "#/$defs/__schema12"
          },
          "gate": {
            "$ref": "#/$defs/__schema14"
          },
          "alwaysAsk": {
            "$ref": "#/$defs/__schema16"
          },
          "lapsed": {
            "$ref": "#/$defs/__schema18"
          },
          "askMessage": {
            "$ref": "#/$defs/__schema20"
          },
          "delaySeconds": {
            "$ref": "#/$defs/__schema22"
          },
          "promotion": {
            "$ref": "#/$defs/__schema24"
          },
          "description": {
            "$ref": "#/$defs/__schema29"
          }
        },
        "required": [
          "key",
          "risk"
        ],
        "additionalProperties": false,
        "description": "An action class, for example `email.send`. Keys are hierarchical, and `*` is the catch-all."
      }
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "reversible_self",
        "reversible_shared",
        "hard_to_reverse",
        "irreversible",
        "regulated"
      ],
      "description": "Risk class, least to most risky. Each has a default ceiling and promotion thresholds."
    },
    "__schema6": {
      "description": "Defaults to true, except for irreversible and regulated.",
      "$ref": "#/$defs/__schema7"
    },
    "__schema7": {
      "type": "boolean"
    },
    "__schema8": {
      "description": "Overrides the risk class's default ceiling.",
      "$ref": "#/$defs/__schema9"
    },
    "__schema9": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Autonomy level, L0 (suggest) to L5 (autonomous)."
    },
    "__schema10": {
      "description": "Levels this action supports. L0 and L1 are always included. Decisions round down.",
      "$ref": "#/$defs/__schema11"
    },
    "__schema11": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema12": {
      "description": "Plan feature that must be included.",
      "$ref": "#/$defs/__schema13"
    },
    "__schema13": {
      "type": "string"
    },
    "__schema14": {
      "description": "Key of a gate flag (variations are a level or false) that rolls this action out.",
      "$ref": "#/$defs/__schema15"
    },
    "__schema15": {
      "type": "string"
    },
    "__schema16": {
      "description": "Always ask, whatever the level. A string gives the reason.",
      "$ref": "#/$defs/__schema17"
    },
    "__schema17": {
      "type": [
        "boolean",
        "string"
      ]
    },
    "__schema18": {
      "description": "Overrides the lapsed-subscriber policy for this class.",
      "$ref": "#/$defs/__schema19"
    },
    "__schema19": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "deny"
            }
          },
          "required": [
            "outcome"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "ask"
            }
          },
          "required": [
            "outcome"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "cap"
            },
            "level": {
              "$ref": "#/$defs/__schema9"
            }
          },
          "required": [
            "outcome",
            "level"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema20": {
      "description": "What the agent says when it asks at L1. Defaults to \"Can I do this?\".",
      "$ref": "#/$defs/__schema21"
    },
    "__schema21": {
      "type": "string"
    },
    "__schema22": {
      "description": "The heads-up window at L2. Defaults to 600.",
      "$ref": "#/$defs/__schema23"
    },
    "__schema23": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema24": {
      "description": "Overrides promotion thresholds for this class, field by field.",
      "$ref": "#/$defs/__schema25"
    },
    "__schema25": {
      "type": "object",
      "properties": {
        "minApprovals": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema26"
            },
            {
              "type": "null"
            }
          ],
          "description": "Attention-weighted approvals needed at the current level. null means manual only."
        },
        "minRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "(approved + 0.5 * edited) / responses."
        },
        "cleanRun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "No rejection or undo in this many most recent outcomes."
        },
        "minDwellMs": {
          "description": "Minimum time at the current level.",
          "$ref": "#/$defs/__schema27"
        },
        "declineCooldownMs": {
          "description": "After a declined offer, wait this long before offering again.",
          "$ref": "#/$defs/__schema27"
        },
        "requiresSigned": {
          "description": "Promotion past Ask needs signed approvals.",
          "$ref": "#/$defs/__schema28"
        }
      },
      "additionalProperties": false
    },
    "__schema26": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema27": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema28": {
      "type": "boolean"
    },
    "__schema29": {
      "type": "string"
    },
    "__schema30": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/$defs/__schema31"
          },
          "on": {
            "$ref": "#/$defs/__schema32"
          },
          "variations": {
            "$ref": "#/$defs/__schema33"
          },
          "offVariation": {
            "$ref": "#/$defs/__schema34"
          },
          "fallthrough": {
            "$ref": "#/$defs/__schema35"
          },
          "rules": {
            "$ref": "#/$defs/__schema39"
          },
          "prerequisites": {
            "$ref": "#/$defs/__schema46"
          },
          "salt": {
            "$ref": "#/$defs/__schema47"
          },
          "owner": {
            "$ref": "#/$defs/__schema49"
          },
          "lifetime": {
            "$ref": "#/$defs/__schema50"
          }
        },
        "required": [
          "key",
          "on",
          "variations",
          "offVariation",
          "fallthrough"
        ],
        "additionalProperties": false,
        "description": "A typed flag. A gate is a flag whose variations are a level or false."
      }
    },
    "__schema31": {
      "type": "string"
    },
    "__schema32": {
      "type": "boolean"
    },
    "__schema33": {
      "type": "array",
      "items": {}
    },
    "__schema34": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema35": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "variation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "variation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rollout": {
              "type": "object",
              "properties": {
                "variations": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema36"
                  },
                  "description": "Weights are percentages and should sum to 100."
                },
                "bucketBy": {
                  "description": "Context kind whose key is hashed. Defaults to `subject`.",
                  "$ref": "#/$defs/__schema38"
                }
              },
              "required": [
                "variations"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "rollout"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema36": {
      "type": "object",
      "properties": {
        "variation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "weight": {
          "$ref": "#/$defs/__schema37"
        }
      },
      "required": [
        "variation",
        "weight"
      ],
      "additionalProperties": false
    },
    "__schema37": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "__schema38": {
      "type": "string"
    },
    "__schema39": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema40"
            }
          },
          "serve": {
            "$ref": "#/$defs/__schema35"
          }
        },
        "required": [
          "id",
          "serve"
        ],
        "additionalProperties": false
      }
    },
    "__schema40": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/__schema41"
        },
        "attr": {
          "$ref": "#/$defs/__schema42"
        },
        "op": {
          "$ref": "#/$defs/__schema43"
        },
        "values": {
          "$ref": "#/$defs/__schema44"
        }
      },
      "required": [
        "kind",
        "attr",
        "op"
      ],
      "additionalProperties": false,
      "description": "A targeting condition on one context kind."
    },
    "__schema41": {
      "type": "string",
      "description": "Context kind, for example `subject`, `agent`, `context` or a custom kind."
    },
    "__schema42": {
      "type": "string",
      "description": "Attribute name. `key` targets the entity key."
    },
    "__schema43": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "in",
        "notIn",
        "gt",
        "gte",
        "lt",
        "lte",
        "exists",
        "missing",
        "startsWith",
        "endsWith",
        "contains",
        "segment",
        "notSegment"
      ]
    },
    "__schema44": {
      "description": "For `segment` and `notSegment`, segment keys.",
      "$ref": "#/$defs/__schema45"
    },
    "__schema45": {
      "type": "array",
      "items": {}
    },
    "__schema46": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "variation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "variation"
        ],
        "additionalProperties": false
      }
    },
    "__schema47": {
      "description": "Salt for bucketing. Defaults to the key.",
      "$ref": "#/$defs/__schema48"
    },
    "__schema48": {
      "type": "string"
    },
    "__schema49": {
      "type": "string"
    },
    "__schema50": {
      "type": "string",
      "enum": [
        "temporary",
        "permanent"
      ]
    },
    "__schema51": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "included": {
            "description": "Members as `kind:key`, for example `subject:user_1`.",
            "$ref": "#/$defs/__schema52"
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "description": "All must match.",
            "$ref": "#/$defs/__schema53"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    "__schema52": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema53": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema40"
      }
    },
    "__schema54": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "running",
              "stopped"
            ]
          },
          "arms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "weight": {
                  "description": "Percentage of assigned traffic. Weights should sum to 100.",
                  "$ref": "#/$defs/__schema37"
                },
                "autonomyCap": {
                  "description": "The most autonomy this arm allows. Omitted means no cap.",
                  "$ref": "#/$defs/__schema9"
                },
                "params": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "key",
                "weight"
              ],
              "additionalProperties": false
            }
          },
          "traffic": {
            "description": "Percentage of eligible subjects enrolled.",
            "$ref": "#/$defs/__schema37"
          },
          "actions": {
            "$ref": "#/$defs/__schema55"
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema40"
            }
          },
          "bucketBy": {
            "description": "Context kind to randomise on. Defaults to `subject`.",
            "$ref": "#/$defs/__schema57"
          },
          "salt": {
            "type": "string"
          },
          "layer": {
            "description": "Experiments in the same layer are mutually exclusive.",
            "$ref": "#/$defs/__schema58"
          }
        },
        "required": [
          "key",
          "status",
          "arms",
          "traffic"
        ],
        "additionalProperties": false
      }
    },
    "__schema55": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema56"
      },
      "description": "Action patterns, for example `email.*`. Omitted means all."
    },
    "__schema56": {
      "type": "string"
    },
    "__schema57": {
      "type": "string"
    },
    "__schema58": {
      "type": "string"
    },
    "__schema59": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "allocations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema60"
            },
            "description": "Bucket ranges as percentages, [start, end)."
          }
        },
        "required": [
          "key",
          "allocations"
        ],
        "additionalProperties": false
      }
    },
    "__schema60": {
      "type": "object",
      "properties": {
        "experiment": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/__schema37"
        },
        "end": {
          "$ref": "#/$defs/__schema37"
        }
      },
      "required": [
        "experiment",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "__schema61": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "percent": {
            "$ref": "#/$defs/__schema37"
          },
          "autonomyCap": {
            "description": "Cap for held-out subjects. Omitted means no cap, just no experiments.",
            "$ref": "#/$defs/__schema9"
          },
          "actions": {
            "$ref": "#/$defs/__schema55"
          },
          "bucketBy": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "percent"
        ],
        "additionalProperties": false
      }
    },
    "__schema62": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "features": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            }
          },
          "ceilings": {
            "description": "Autonomy ceilings by risk class for subjects on this plan.",
            "$ref": "#/$defs/__schema63"
          }
        },
        "required": [
          "key",
          "features"
        ],
        "additionalProperties": false
      }
    },
    "__schema63": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema5"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema64": {
      "description": "What happens when the subscription that granted an action has lapsed.",
      "$ref": "#/$defs/__schema65"
    },
    "__schema65": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "reversible_self",
          "reversible_shared",
          "hard_to_reverse",
          "irreversible",
          "regulated",
          "default"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema19"
      }
    },
    "__schema66": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema67"
          },
          "effect": {
            "$ref": "#/$defs/__schema68"
          },
          "actions": {
            "$ref": "#/$defs/__schema69"
          },
          "when": {
            "$ref": "#/$defs/__schema70"
          },
          "message": {
            "$ref": "#/$defs/__schema71"
          }
        },
        "required": [
          "id",
          "effect"
        ],
        "additionalProperties": false,
        "description": "Forbid wins over everything except a broken config."
      }
    },
    "__schema67": {
      "type": "string"
    },
    "__schema68": {
      "type": "string",
      "const": "forbid"
    },
    "__schema69": {
      "$ref": "#/$defs/__schema55"
    },
    "__schema70": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema40"
      }
    },
    "__schema71": {
      "type": "string"
    },
    "__schema72": {
      "description": "Kill switches. Action patterns denied for everyone.",
      "$ref": "#/$defs/__schema55"
    },
    "__schema73": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/__schema74"
          },
          {
            "$ref": "#/$defs/__schema77"
          },
          {
            "$ref": "#/$defs/__schema78"
          },
          {
            "$ref": "#/$defs/__schema79"
          },
          {
            "$ref": "#/$defs/__schema80"
          },
          {
            "$ref": "#/$defs/__schema81"
          },
          {
            "$ref": "#/$defs/__schema82"
          },
          {
            "$ref": "#/$defs/__schema83"
          },
          {
            "$ref": "#/$defs/__schema84"
          }
        ],
        "description": "A layer 2 rule. Rules only lower a level or force an ask, never raise anything."
      }
    },
    "__schema74": {
      "type": "object",
      "properties": {
        "actions": {
          "$ref": "#/$defs/__schema75"
        },
        "minLevel": {
          "$ref": "#/$defs/__schema76"
        },
        "type": {
          "type": "string",
          "const": "novelty"
        },
        "field": {
          "type": "string"
        },
        "envelope": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "field"
      ],
      "additionalProperties": false
    },
    "__schema75": {
      "$ref": "#/$defs/__schema55"
    },
    "__schema76": {
      "description": "Only applies at or above this level. Defaults to L2.",
      "$ref": "#/$defs/__schema9"
    },
